*.ktx
*.exe
*.ttf
*.filamat
app/
*.jpg
*.png
# Intentional, compact manuscript-style diagnostic comparison figure.
!comparisons/scene18_clone_00259_native_v1_20261004/side_by_side.png
!experiments/G/figures/Scene20__clone__00088_all_arms.png
*.ply
*.pcd
venv/

# uv-managed Python environments (keep pyproject.toml and uv.lock tracked)
.venv/
.uv/

# Python bytecode, tooling caches, and build artifacts
__pycache__/
*.py[cod]
*.so
*.egg-info/
build/
dist/
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/

# Local model checkpoints and exported inference artifacts
models/**/*.pt
models/**/*.pth
models/**/*.ckpt
models/**/*.onnx
models/**/*.engine
models/**/*.part

# Checkpoints downloaded/staged anywhere under experiments (e.g. yolo encoder weights)
experiments/**/models/**/*.pt
experiments/**/models/**/*.pth
experiments/**/models/**/*.ckpt
experiments/**/models/**/*.onnx

# Skill reference screenshots: white-listed despite the global *.png rule
!.agents/skills/**/*.png

# Third-party source checkouts used only to deserialize research checkpoints
external_models/

# Ablation checkpoints; retain experiment configs, manifests, CSV and reports
experiments/**/runs/**/*.pth
experiments/**/runs/**/*.pt
# Keep best checkpoints from experiment runs eligible for Git. Other snapshots
# remain ignored; downloaded/pretrained weights under models/ remain ignored.
!experiments/**/runs/**/best*.pth
!experiments/**/runs/**/best*.pt
# Smoke/probe outputs are diagnostics, not the selected ablation weights.
experiments/**/runs/*smoke*/**/best*.pth
experiments/**/runs/*smoke*/**/best*.pt
experiments/**/runs/probe*/**/best*.pth
experiments/**/runs/probe*/**/best*.pt
experiments/**/runs/**/*smoke*/best*.pth
experiments/**/runs/**/*smoke*/best*.pt
experiments/**/runs/**/probe*/best*.pth
experiments/**/runs/**/probe*/best*.pt
experiments/**/runs/**/*probe*/best*.pth
experiments/**/runs/**/*probe*/best*.pt

# Generated captures, videos, and saved experiment arrays
*.mp4
*.avi
*.mkv
*.npy
*.npz

# Third-party reference papers: local research copies only, redistribution
# rights unverified. Keep summaries and figures; never publish the PDFs.
paper/reference_papers/**/*.pdf
