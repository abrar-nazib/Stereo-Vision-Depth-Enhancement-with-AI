  <diagram id="context" name="Why this shape — 1-paragraph map">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1400" pageHeight="800">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="How each piece earned its place (all numbers = held-out EPE, 200-pair protocol unless noted)" style="text;html=1;fontSize=16;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="1000" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="FROZEN YOLO encoder&#10;• User's constraint: never train the encoder (StereoLite precedent was actually TRAINED — 0.79&#10;• Sanity test: frozen 6.02 vs scratch 13.11 on 20-pair overfit → frozen features carry MORE signal&#10;• 0.84-recipe reproduction in user's code: 0.77 → machinery never was the problem" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="420" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="v2_hitnet head (user's own design)&#10;• Won A04 ablation: iterative refinement 5.87 beat LightStereo-M 6.52 at 0.84M params&#10;• Faithful HITNet propagation (CVPR21 Sec 3.4): dilated residual blocks, no BN, plane-eq upsampling&#10;• User's 0.84 overfit record reproduced at 0.77 in this exact head" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="490" y="80" width="420" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="Multi-scale loss (user's modal recipe)&#10;• Ported verbatim from train_arch_sceneflow.py: deep supervision ×1/×2/×4/×8/×16 + grad + bad1-hinge&#10;• A07v2-B proved it: 5.66 → 4.26 (−25%) with ZERO architecture change&#10;• Our earlier pooled approximation was the &quot;something wrong&quot; the user kept smelling" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="940" y="80" width="420" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="V-arm (SGNet veto) — fusion role winner&#10;• 26 papers read; every working shared-encoder design lets semantics GATE, never MATCH&#10;• E dimmer −0.16 · V referee −0.33 · D guide −0.28 · V+D stacked: best-ckpt 3.75 but unstable final&#10;• V adopted: best final EPE 3.93 + RMSE, cleaner bad-1/D1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="420" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="Data scaling (A08, running now)&#10;• 160 pairs → 800 (from the 4,400 already on disk; zero download)&#10;• 35k steps per user instruction; eval every 500 on 200 held-out&#10;• Question answered when done: does held-out beat 3.93?&#10;• If still falling at 35k → extend steps next; if ~3.0 → scale to 2000+/FlyingThings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;" vertex="1" parent="1">
