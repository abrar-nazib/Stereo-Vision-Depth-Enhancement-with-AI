        <!-- ============ TITLE ============ -->
        <mxCell id="title" value="A08 — YOLO26s-seg (frozen, ADE20K) + V-arm fusion + v2_hitnet head&#10;1000-pair SceneFlow Driving, 35k steps — THE CURRENT RUN" style="text;html=1;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="340" y="20" width="920" height="50" as="geometry" />
        </mxCell>

        <!-- ============ ENCODER COLUMN ============ -->
        <mxCell id="encBox" value="FROZEN ENCODER — YOLO26s-seg backbone (ADE20K, layers 0–6)&#10;requires_grad=False, eval() always. Seg head/neck REMOVED from graph — only trunk reused" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="300" height="620" as="geometry" />
        </mxCell>
        <mxCell id="inp" value="Left image B×3×540×960&#10;+ Right image (batched 2B)&#10;value = x / 255" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="140" width="240" height="54" as="geometry" />
        </mxCell>
        <mxCell id="l0" value="[0] Conv s2 → 32ch @ 1/2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef3fb;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="210" width="240" height="30" as="geometry" />
        </mxCell>
        <mxCell id="l12" value="[1] Conv s2 → 64ch @ 1/4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef3fb;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="248" width="240" height="30" as="geometry" />
        </mxCell>
        <mxCell id="l2" value="[2] C3k2 → f2 = 128ch @ 1/4  ● tap" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="70" y="286" width="240" height="30" as="geometry" />
        </mxCell>
        <mxCell id="l34" value="[3] Conv s2 · [4] C3k2 → f8 = 256ch @ 1/8  ● tap" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="70" y="324" width="240" height="30" as="geometry" />
        </mxCell>
        <mxCell id="l56" value="[5] Conv s2 · [6] C3k2 → f16 = 256ch @ 1/16  ● tap" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="70" y="362" width="240" height="30" as="geometry" />
        </mxCell>
        <mxCell id="l710" value="[7] Conv s2 · [8] C3k2 · [9] SPPF · [10] C2PSA → 512ch @ 1/32&#10;(computed in the chain but UNUSED — dead compute, dropped)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=9;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="70" y="400" width="240" height="44" as="geometry" />
        </mxCell>
        <mxCell id="segNote" value="Seg neck + proto head: NOT in this model.&#10;Seg ability lives in the frozen weights;&#10;no seg labels are used anywhere in A08." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=9;fontColor=#333333;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="460" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="provNote" value="Empirical proof this encoder is fine:&#10;overfit sanity — frozen 6.02 vs scratch 13.11&#10;(frozen BEAT trainable scratch)&#10;repro of user's 0.84 recipe: 0.77" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="70" y="540" width="240" height="70" as="geometry" />
        </mxCell>

        <!-- ============ V-ARM FUSION ============ -->
        <mxCell id="fuseBox" value="V-ARM FUSION (SGNet confidence) — the winning ablation arm&#10;injects at TileInit, paper-faithful placement" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;verticalAlign=top;align=center;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="390" y="430" width="330" height="220" as="geometry" />
        </mxCell>
        <mxCell id="v1" value="sem_corr: for d = 0..23:&#10;corr_d = mean_ch( norm(fL16) · shift(norm(fR16), d) )" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="410" y="470" width="290" height="36" as="geometry" />
        </mxCell>
        <mxCell id="v2" value="x = disp_corr (channel-mean of raw cv) ⊙ sem_corr" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="410" y="514" width="290" height="26" as="geometry" />
        </mxCell>
        <mxCell id="v3" value="conf = σ( TransConv3d( ReLU(Conv3d s2( ReLU(Conv3d(x, 16ch, k3) ))) ) + skip )&#10;computed in fp32 (product underflows fp16); tconv bias init 2.0 → conf ≈ 0.88 neutral at start" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="410" y="548" width="290" height="44" as="geometry" />
        </mxCell>
        <mxCell id="v4" value="cv_gated = conf ⊙ agg[:3](cv)   →   logits = agg[3:](cv_gated)&#10;(7.8K trainable params; multiplies the post-conv3d map, SGNet Sec 3.4)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="410" y="600" width="290" height="40" as="geometry" />
        </mxCell>

        <!-- ============ HEAD COLUMN ============ -->
        <mxCell id="headBox" value="v2_hitnet HEAD (A03 vendored, trains) — 0.421M trainable / 1.647M total" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="770" y="100" width="430" height="700" as="geometry" />
        </mxCell>
        <mxCell id="cv" value="GROUPWISE CORRELATION VOLUME @ 1/16 (TileInit)&#10;cv[b,g,d,h,w] = mean(fL16_g · shift(fR16_g, d)),  g=8 groups, d=0..23&#10;shape (B, 8, 24, 34, 60)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="790" y="140" width="390" height="50" as="geometry" />
        </mxCell>
        <mxCell id="agg" value="TileInit.agg: Conv3d(8→16,k3) · GN · SiLU · Conv3d(16→16,k3) · GN · SiLU&#10;[V-arm gate multiplies HERE] · Conv3d(16→1,k3) → softmax over d&#10;d_init = Σ d·P(d)   (soft-argmin, subpixel)   conf = max P(d)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="790" y="200" width="390" height="56" as="geometry" />
        </mxCell>
        <mxCell id="tilestate" value="TileState = ( d, sx=0, sy=0, feat 16ch from fL16, conf )" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3f3f3;strokeColor=#9673a6;fontSize=9;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="790" y="264" width="390" height="24" as="geometry" />
        </mxCell>
        <mxCell id="prop16" value="1/16 · HITNetPropagate ×1&#10;warp fR16 by d → φ(d−1), φ(d), φ(d+1) local cost&#10;a = [feat, fL16, fR_w, d, sx, sy, conf, costs] → 1×1 reduce →&#10;residual blocks k3 dilated, NO BN, LeakyReLU 0.2 → Δd, Δsx, Δsy, Δconf" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="790" y="296" width="390" height="64" as="geometry" />
        </mxCell>
        <mxCell id="up8" value="TileUpsample ×2 (plane equation: d' = bilinear(d)·2 + sx·dx + sy·dy) → 1/8" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3f3f3;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="790" y="368" width="390" height="24" as="geometry" />
        </mxCell>
        <mxCell id="prop8" value="1/8 · HITNetPropagate ×1 (256ch f8 features)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="790" y="400" width="390" height="24" as="geometry" />
        </mxCell>
        <mxCell id="up4" value="TileUpsample ×2 → 1/4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3f3f3;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="790" y="432" width="390" height="24" as="geometry" />
        </mxCell>
        <mxCell id="prop4" value="1/4 · HITNetPropagate ×1 (128ch f4 features)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="790" y="464" width="390" height="24" as="geometry" />
        </mxCell>
        <mxCell id="up2" value="TileUpsample ×2 → 1/2 → d_half" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3f3f3;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="790" y="496" width="390" height="24" as="geometry" />
        </mxCell>
        <mxCell id="prop2" value="1/2 · HITNetPropagate ×1 (64ch f2 features)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="790" y="528" width="390" height="24" as="geometry" />
        </mxCell>
        <mxCell id="upfull" value="TileUpsample ×2 → FULL RES 540×960 (plane upsample, NO convex upsample — HITNet-exact)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="790" y="560" width="390" height="30" as="geometry" />
        </mxCell>
        <mxCell id="out" value="d_final  B×1×540×960" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="880" y="604" width="210" height="34" as="geometry" />
        </mxCell>

        <!-- ============ LOSS PANEL ============ -->
        <mxCell id="lossBox" value="TRAINING — the user's modal multi-scale loss (the −25% fix)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="1240" y="100" width="330" height="330" as="geometry" />
        </mxCell>
        <mxCell id="lossTerms" value="L = 1.0·msL1(d_final, ×1)&#10;+ 0.5·msL1(d_half, ×2)&#10;+ 0.3·msL1(d4, ×4)&#10;+ 0.2·msL1(d8, ×8)&#10;+ 0.1·msL1(d16, ×16)&#10;+ 0.5·grad_consistency(d_final)&#10;+ 0.2·bad1_hinge((err−1)²)&#10;&#10;msL1: upsample pred to GT res, ×scale correction&#10;Deep supervision on EVERY scale's disparity.&#10;This was the single biggest fix: 5.66 → 4.26" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=9;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1255" y="140" width="300" height="200" as="geometry" />
        </mxCell>
        <mxCell id="trainOpts" value="AdamW 2e-4, wd 1e-5 · grad-clip 1.0 · AMP fp16&#10;batch 1 · native 384×640 crops (÷32 exact, no padding)&#10;full 540×960 eval, replicate-pad stripped pre-metric&#10;mask: finite GT, 0 &lt; d &lt; 192" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=9;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1255" y="348" width="300" height="76" as="geometry" />
        </mxCell>

        <!-- ============ DATA PANEL ============ -->
        <mxCell id="dataBox" value="DATA (A08 — the current experiment)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="1240" y="470" width="330" height="230" as="geometry" />
